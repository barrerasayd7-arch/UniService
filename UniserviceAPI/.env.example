# ============================================
# VARIABLES DE ENTORNO - UniService API
# ============================================
# Local: copia este archivo como  UniserviceAPI/UniserviceAPI/.env  (junto a Program.cs)
#        o como  UniserviceAPI/.env  y rellena los valores.
# Nube:  define estas mismas variables en el panel del hosting (no subas un .env).
#
# Reglas del archivo:
#   - Una variable por línea, formato CLAVE=valor, sin comillas.
#   - El doble guion bajo (__) equivale a ":" en appsettings (Jwt__Key = Jwt:Key).
#   - NUNCA subas el .env real a git (ya está en .gitignore). Las claves reales
#     se comparten por un canal privado, no por el repositorio ni grupos abiertos.
# ============================================

# ── Obligatorias ─────────────────────────────

# Base de datos (Supabase → Project Settings → Database → Connection string, modo Session pooler)
ConnectionStrings__DefaultConnection=Host=aws-1-sa-east-1.pooler.supabase.com;Port=5432;Database=postgres;Username=postgres.TU_PROYECTO;Password=TU_PASSWORD;SSL Mode=Require;Trust Server Certificate=true

# Firma de las sesiones (JWT). Mínimo 32 caracteres aleatorios; la API no arranca sin ella.
# Todo el equipo y la nube deben usar LA MISMA si comparten base de datos y sesiones.
# Generar en PowerShell (sirve también para CodeKey):
#   $b = New-Object byte[] 48; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
Jwt__Key=GENERA_UNA_CLAVE_ALEATORIA_DE_AL_MENOS_32_CARACTERES

# Firma de los códigos de correo institucional (OTP). Mínimo 32 caracteres, distinta de Jwt__Key.
# Sin ella, send-code / verify-code / register responden 503.
InstitutionalEmail__CodeKey=GENERA_OTRA_CLAVE_ALEATORIA_DE_AL_MENOS_32_CARACTERES

# Brevo: envío de correos (códigos OTP, avisos de servicios)
Brevo__ApiKey=TU_API_KEY_DE_BREVO
Brevo__FromEmail=codigos@serviown.com
Brevo__FromName=UniService

# Supabase Storage: imágenes de servicios, avatares y evidencias de reportes
Supabase__Url=https://TU_PROYECTO.supabase.co
Supabase__ServiceKey=TU_SERVICE_ROLE_KEY

# ── Sólo en la nube (producción) ─────────────

# Dominios web que pueden llamar a la API, separados por coma (la app móvil no lo necesita).
# En Development se permite cualquier origen y esta variable se ignora.
# AllowedOrigins=https://serviown.com,https://www.serviown.com

# Entorno. En la nube debe ser Production (oculta Swagger y detalles de errores).
# ASPNETCORE_ENVIRONMENT=Production

# ── Opcionales ───────────────────────────────

# OBSOLETO: hash BCrypt de la contraseña maestra compartida de la web antigua (POST /api/auth/verify-admin-master).
# Si no se define, ese endpoint responde 503. El panel nuevo NO la usa: cada admin tiene su propia
# contraseña de administrador en la tabla admin_credenciales (migración 010, /api/admin/acceso).
# Admin__MasterPasswordHash=$2a$11$...
